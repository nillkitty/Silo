<Window x:Class="Silo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:tt="http://schemas.telerik.com/2008/xaml/presentation/pivot"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:Silo"
        xmlns:ui="clr-namespace:Silo.Ui"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
 
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:MenuBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
        <ToolBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
        <t:RadNavigationView x:Name="NavTree" AllowMultipleExpandedItems="True" AutoChangeDisplayMode="True"
                             IsPaneOpen="True"
                    Grid.Row="2" Grid.Column="0"
                    FontWeight="Normal" FontSize="18"
                               DisplayMode="Expanded">
                <t:RadNavigationView.Items>
                <t:RadNavigationViewItem Content="Silo" IsExpanded="True"
                                         Icon="{l:AppIcon Icon={StaticResource DataModel}}">
                    
                    <t:RadNavigationViewItem.Items>
                        <t:RadNavigationViewItem Content="Schema"        Icon="{l:AppIcon {StaticResource FlowDiagram}}" />
                        <t:RadNavigationViewItem Content="Data"           Icon="{l:AppIcon {StaticResource Database6}}"/>
                        <t:RadNavigationViewItem Content="Visualization" Icon="{l:AppIcon {StaticResource MindMap}}" />
                        <t:RadNavigationViewItem Content="Analysis"      Icon="{l:AppIcon {StaticResource Analytics}}" /> 
                    </t:RadNavigationViewItem.Items>
                    </t:RadNavigationViewItem>
                    <t:RadNavigationViewItem Content="Connections" 
                                             Icon="{l:AppIcon Icon={StaticResource Plug}}"
                                             IsExpanded="True">

                    <t:RadNavigationViewItem.Items>
                        <t:RadNavigationViewItem Content="Destinations" Icon="{l:AppIcon {StaticResource Destination}}">
                  
                        </t:RadNavigationViewItem>
                        <t:RadNavigationViewItem Content="Credentials"  Icon="{l:AppIcon {StaticResource Key}}"/>
                        <t:RadNavigationViewItem Content="Movements"  Icon="{l:AppIcon {StaticResource Transfer1}}"/>
                        <t:RadNavigationViewItem Content="Jobs" Icon="{l:AppIcon {StaticResource Folder17}}"/>
                        <t:RadNavigationViewItem Content="Connector Space" Icon="{l:AppIcon {StaticResource Database5}}"/>
                        </t:RadNavigationViewItem.Items>

                    </t:RadNavigationViewItem>
                </t:RadNavigationView.Items>
            </t:RadNavigationView>
        <t:RadDocking Grid.Row="2"  Grid.Column="1">
            <t:RadSplitContainer InitialPosition="DockedRight">
                <t:RadSplitContainer InitialPosition="DockedTop">
                    <t:RadPaneGroup>
                        <t:RadPane Header="Toolbox">

                        </t:RadPane>
                    </t:RadPaneGroup>
                </t:RadSplitContainer>
                <t:RadPaneGroup>
                    <t:RadPane Header="Selected Item">
                        
                    </t:RadPane>
                </t:RadPaneGroup>
            </t:RadSplitContainer>
        </t:RadDocking>
        <StatusBar Grid.Row="3" Grid.Column="0"  Grid.ColumnSpan="2">
            <StatusBarItem Name="StatusError"></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

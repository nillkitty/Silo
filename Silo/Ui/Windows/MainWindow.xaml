<Window x:Class="Silo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:xcad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:xcadLayout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:Silo"
        xmlns:ui="clr-namespace:Silo.Ui"
        mc:Ignorable="d"
        Background="{DynamicResource Theme.Background}"
        Foreground="{DynamicResource Theme.Text}"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <!--
            One icon-only button per top-level nav group, shown in NavRail (the collapsed
            nav pane's gutter - see the Grid in the nav cell below) in place of the full
            tree. IsChecked marks the group containing the currently-selected item (see
            MainWindow.xaml.cs's NavTree_SelectedItemChanged) - a left accent bar plus
            tinted background/icon color, so it's still clear what the main document view
            represents even with the pane collapsed.
        -->
        <Style x:Key="NavRailButtonStyle" TargetType="{x:Type ToggleButton}">
            <!-- No fixed Width/Height: the button is as big as its icon (the live "Icon Size" setting) plus Padding. -->
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Selection}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Shared by the top tree (NavTree) and the bottom tree (NavTreeBottom): one recursive template for a node
            and its children, and the style that lets code drive selection/expansion through AppNavNode. The text
            turns to the accent colour for the node of the active Silo (AppNavNode.IsEmphasized).
        -->
        <HierarchicalDataTemplate x:Key="NavNodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <l:AppIcon Icon="{Binding Item.Icon}" Margin="0,0,6,0" />
                <TextBlock x:Name="NavNodeText" Text="{Binding Header}" VerticalAlignment="Center" />
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <!-- accent text marks the active Silo, but not while its row is selected (the accent on the selection colour is unreadable) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEmphasized}" Value="True" />
                        <Condition Binding="{Binding IsSelected}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NavNodeText" Property="Foreground" Value="{DynamicResource Theme.Accent}" />
                </MultiDataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!--
            Lets code (MainWindow.xaml.cs) drive selection and expansion by setting AppNavNode.IsSelected/IsExpanded,
            without reaching into the TreeView's realized containers - the standard way to make a data-bound
            TreeView's selection settable from outside a mouse click.
        -->
        <Style x:Key="NavNodeContainerStyle" TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <!-- One icon button in NavRail / NavRailBottom (the collapsed pane's gutter). -->
        <DataTemplate x:Key="NavRailItemTemplate">
            <ToggleButton Style="{StaticResource NavRailButtonStyle}"
                          Click="NavRailButton_Click"
                          IsChecked="{Binding IsActiveRoot, Mode=OneWay}"
                          ToolTip="{Binding Header}">
                <l:AppIcon Icon="{Binding Item.Icon}" />
            </ToggleButton>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="32" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:MenuBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
        <ToolBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
        <!--
            Was a Telerik RadNavigationView. A plain TreeView doesn't have that control's
            collapsible-pane display modes (AutoChangeDisplayMode/IsPaneOpen/DisplayMode)
            built in, so a small hand-rolled equivalent sits above it here: a header bar
            with a toggle button that shrinks NavColumn down to a narrow rail and hides the
            tree (see MainWindow.xaml.cs's NavCollapseToggle_Click), mirroring
            RadNavigationView's collapsed/expanded pane behavior.

            NavTree's structure (and NavRail's) is no longer written out here as XAML - it's
            built in code from Nav/AppNavTree.cs's AppNavItem/AppNavNode model (see
            MainWindow.xaml.cs's SyncNav) and bound through the HierarchicalDataTemplate
            below. Ctrl+right-click the tree (in Author mode or above) still reaches the pink
            design menu via Design/DesignMenu.cs - that attaches to any DependencyObject,
            unaffected by how the TreeView gets its items.
        -->
        <Grid x:Name="NavHost" Grid.Row="2" Grid.Column="0" SizeChanged="NavHost_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Theme.BackgroundAlt}"
                    BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True" Margin="4,2">
                    <ToggleButton x:Name="NavCollapseToggle"
                                  DockPanel.Dock="Left"
                                  Width="24" Height="24"
                                  Click="NavCollapseToggle_Click"
                                  IsChecked="True"
                                  ToolTip="Expand navigation pane">
                        <ToggleButton.Style>
                            <Style TargetType="{x:Type ToggleButton}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                                                <Path x:Name="NavToggleArrow"
                                                      Data="M 7 2 L 3 6 L 7 10"
                                                      Stroke="{DynamicResource Theme.Text}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="10" Height="12"
                                                      Stretch="Uniform"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="NavToggleArrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock x:Name="NavHeaderText"
                               Text="Navigation"
                               Visibility="Collapsed"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               FontWeight="SemiBold" />
                </DockPanel>
            </Border>

            <!--
                NavTree holds the top of the pane: "Recent" while no Silo is open, otherwise one node per open Silo
                plus Connections and Performance. NavTreeBottom, in the last row, holds Inbox, Settings and Profile,
                which stay at the bottom edge whatever the top shows (and grow upward when Settings is expanded -
                MainWindow.xaml.cs caps its height so the top tree always keeps some room). Both bind to AppNavNode
                lists that MainWindow.xaml.cs fills and keeps in step with the open Silos (SyncNav); the
                HierarchicalDataTemplate applies itself recursively, so one template covers every level.
            -->
            <TreeView x:Name="NavTree"
                      Grid.Row="1"
                      FontWeight="Normal" FontSize="18"
                      ItemTemplate="{StaticResource NavNodeTemplate}"
                      ItemContainerStyle="{StaticResource NavNodeContainerStyle}"
                      SelectedItemChanged="NavTree_SelectedItemChanged" />

            <TreeView x:Name="NavTreeBottom"
                      Grid.Row="2"
                      VerticalAlignment="Bottom"
                      FontWeight="Normal" FontSize="18"
                      ItemTemplate="{StaticResource NavNodeTemplate}"
                      ItemContainerStyle="{StaticResource NavNodeContainerStyle}"
                      SelectedItemChanged="NavTree_SelectedItemChanged" />

            <!--
                Collapsed-pane gutter: one icon per top-level node (the top ones under the header, Inbox/Settings/
                Profile at the bottom), with the active one highlighted (see NavRailButtonStyle above and
                AppNavNode.IsActiveRoot). Each shares a Grid cell with its tree - ApplyNavState keeps their
                Visibility opposite one another, so exactly one of the two is ever showing.
            -->
            <ItemsControl x:Name="NavRail"
                          Grid.Row="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Margin="0,6,0,0"
                          ItemTemplate="{StaticResource NavRailItemTemplate}"
                          Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl x:Name="NavRailBottom"
                          Grid.Row="2"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,6"
                          ItemTemplate="{StaticResource NavRailItemTemplate}"
                          Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

        <!--
            Was Telerik RadDocking/RadSplitContainer/RadPaneGroup/RadPane. AvalonDock's
            DockingManager/LayoutRoot/LayoutPanel/LayoutAnchorablePane/LayoutAnchorable is
            the closest free/open-source equivalent - same idea (a LayoutPanel arranges
            LayoutAnchorablePanes, each holding one or more LayoutAnchorable "pane tabs"),
            same two permanently-docked panes (Toolbox above, Selected Item below) as
            before. Every ITool that opens into the dock area (see Tools/IconViewer.cs's
            ToolBase.GetPane()) now returns a LayoutAnchorable the same way it used to
            return a RadPane.

            "Selected Item" (now named SelectedItemPane) doubles as the nav content host:
            when a selected nav item has an AppView, MainWindow.xaml.cs's
            NavTree_SelectedItemChanged sets this pane's Content to that view's built
            UIElement and its Title to the view's Name - the "selected [nav] item" title was
            already a good fit for exactly that.
        -->
        <xcad:DockingManager x:Name="DockHost" Grid.Row="2" Grid.Column="1">
            <xcad:DockingManager.Layout>
                <xcadLayout:LayoutRoot>
                    <xcadLayout:LayoutPanel Orientation="Vertical">
                        <xcadLayout:LayoutAnchorablePane>
                            <xcadLayout:LayoutAnchorable x:Name="ToolboxPane" Title="Toolbox">

                            </xcadLayout:LayoutAnchorable>
                        </xcadLayout:LayoutAnchorablePane>
                        <xcadLayout:LayoutAnchorablePane>
                            <xcadLayout:LayoutAnchorable x:Name="SelectedItemPane" Title="Selected Item">

                            </xcadLayout:LayoutAnchorable>
                        </xcadLayout:LayoutAnchorablePane>
                    </xcadLayout:LayoutPanel>
                </xcadLayout:LayoutRoot>
            </xcad:DockingManager.Layout>
        </xcad:DockingManager>

        <StatusBar Grid.Row="3" Grid.Column="0"  Grid.ColumnSpan="2">
            <StatusBarItem Name="StatusError"></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

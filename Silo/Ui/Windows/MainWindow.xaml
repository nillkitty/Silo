<Window x:Class="Silo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:xcad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:xcadLayout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:Silo"
        xmlns:ui="clr-namespace:Silo.Ui"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <!--
            One icon-only button per top-level nav group, shown in NavRail (the collapsed
            nav pane's gutter - see the Grid in the nav cell below) in place of the full
            tree. IsChecked marks the group containing the currently-selected item (see
            MainWindow.xaml.cs's NavTree_SelectedItemChanged) - a left accent bar plus
            tinted background/icon color, so it's still clear what the main document view
            represents even with the pane collapsed.
        -->
        <Style x:Key="NavRailButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Selection}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="300" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:MenuBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
        <ToolBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
        <!--
            Was a Telerik RadNavigationView. A plain TreeView doesn't have that control's
            collapsible-pane display modes (AutoChangeDisplayMode/IsPaneOpen/DisplayMode)
            built in, so a small hand-rolled equivalent sits above it here: a header bar
            with a toggle button that shrinks NavColumn down to a narrow rail and hides the
            tree (see MainWindow.xaml.cs's NavCollapseToggle_Click), mirroring
            RadNavigationView's collapsed/expanded pane behavior. Everything else (the
            nested item structure, the AppIcon icons, Ctrl+right-click reaching the pink
            design menu via Design/DesignMenu.cs) carries over unchanged - DesignMenu
            attaches to any DependencyObject, TreeView included.
        -->
        <Grid Grid.Row="2" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Theme.BackgroundAlt}"
                    BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True" Margin="4,2">
                    <ToggleButton x:Name="NavCollapseToggle"
                                  DockPanel.Dock="Left"
                                  Width="24" Height="24"
                                  Click="NavCollapseToggle_Click"
                                  ToolTip="Collapse navigation pane">
                        <ToggleButton.Style>
                            <Style TargetType="{x:Type ToggleButton}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                                                <Path x:Name="NavToggleArrow"
                                                      Data="M 7 2 L 3 6 L 7 10"
                                                      Stroke="{DynamicResource Theme.Text}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="10" Height="12"
                                                      Stretch="Uniform"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="NavToggleArrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock x:Name="NavHeaderText"
                               Text="Navigation"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               FontWeight="SemiBold" />
                </DockPanel>
            </Border>

            <TreeView x:Name="NavTree"
                      Grid.Row="1"
                      FontWeight="Normal" FontSize="18"
                      SelectedItemChanged="NavTree_SelectedItemChanged">
            <TreeViewItem x:Name="SiloRootItem" IsExpanded="True">
                <TreeViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <l:AppIcon Icon="{StaticResource DataModel}" Margin="0,0,6,0" />
                        <TextBlock Text="Silo" VerticalAlignment="Center" />
                    </StackPanel>
                </TreeViewItem.Header>

                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <l:AppIcon Icon="{StaticResource FlowDiagram}" Margin="0,0,6,0" />
                            <TextBlock Text="Schema" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <l:AppIcon Icon="{StaticResource Database6}" Margin="0,0,6,0" />
                            <TextBlock Text="Data" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <l:AppIcon Icon="{StaticResource MindMap}" Margin="0,0,6,0" />
                            <TextBlock Text="Visualization" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <l:AppIcon Icon="{StaticResource Analytics}" Margin="0,0,6,0" />
                            <TextBlock Text="Analysis" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
            </TreeViewItem>

            <TreeViewItem x:Name="ConnectionsRootItem" IsExpanded="True">
                <TreeViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <l:AppIcon Icon="{StaticResource Plug}" Margin="0,0,6,0" />
                        <TextBlock Text="Connections" VerticalAlignment="Center" />
                    </StackPanel>
                </TreeViewItem.Header>

                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <l:AppIcon Icon="{StaticResource Destination}" Margin="0,0,6,0" />
                            <TextBlock Text="Destinations" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <l:AppIcon Icon="{StaticResource Key}" Margin="0,0,6,0" />
                            <TextBlock Text="Credentials" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <l:AppIcon Icon="{StaticResource Transfer1}" Margin="0,0,6,0" />
                            <TextBlock Text="Movements" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <l:AppIcon Icon="{StaticResource Folder17}" Margin="0,0,6,0" />
                            <TextBlock Text="Jobs" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem>
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <l:AppIcon Icon="{StaticResource Database5}" Margin="0,0,6,0" />
                            <TextBlock Text="Connector Space" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
            </TreeViewItem>
            </TreeView>

            <!--
                Collapsed-pane gutter: one icon per top-level nav group, with the active
                ancestor highlighted (see NavRailButtonStyle above and
                NavTree_SelectedItemChanged below). Occupies the same cell as NavTree -
                NavCollapseToggle_Click keeps their Visibility opposite one another, so
                exactly one of the two is ever showing.
            -->
            <StackPanel x:Name="NavRail"
                        Grid.Row="1"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"
                        Visibility="Collapsed">
                <ToggleButton x:Name="SiloRailButton"
                              Style="{StaticResource NavRailButtonStyle}"
                              Click="SiloRailButton_Click"
                              ToolTip="Silo">
                    <l:AppIcon Icon="{StaticResource DataModel}" Size="18" />
                </ToggleButton>
                <ToggleButton x:Name="ConnectionsRailButton"
                              Style="{StaticResource NavRailButtonStyle}"
                              Click="ConnectionsRailButton_Click"
                              ToolTip="Connections">
                    <l:AppIcon Icon="{StaticResource Plug}" Size="18" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!--
            Was Telerik RadDocking/RadSplitContainer/RadPaneGroup/RadPane. AvalonDock's
            DockingManager/LayoutRoot/LayoutPanel/LayoutAnchorablePane/LayoutAnchorable is
            the closest free/open-source equivalent - same idea (a LayoutPanel arranges
            LayoutAnchorablePanes, each holding one or more LayoutAnchorable "pane tabs"),
            same two permanently-docked panes (Toolbox above, Selected Item below) as
            before. Every ITool that opens into the dock area (see Tools/IconViewer.cs's
            ToolBase.GetPane()) now returns a LayoutAnchorable the same way it used to
            return a RadPane.
        -->
        <xcad:DockingManager Grid.Row="2" Grid.Column="1">
            <xcad:DockingManager.Layout>
                <xcadLayout:LayoutRoot>
                    <xcadLayout:LayoutPanel Orientation="Vertical">
                        <xcadLayout:LayoutAnchorablePane>
                            <xcadLayout:LayoutAnchorable Title="Toolbox">

                            </xcadLayout:LayoutAnchorable>
                        </xcadLayout:LayoutAnchorablePane>
                        <xcadLayout:LayoutAnchorablePane>
                            <xcadLayout:LayoutAnchorable Title="Selected Item">

                            </xcadLayout:LayoutAnchorable>
                        </xcadLayout:LayoutAnchorablePane>
                    </xcadLayout:LayoutPanel>
                </xcadLayout:LayoutRoot>
            </xcad:DockingManager.Layout>
        </xcad:DockingManager>

        <StatusBar Grid.Row="3" Grid.Column="0"  Grid.ColumnSpan="2">
            <StatusBarItem Name="StatusError"></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

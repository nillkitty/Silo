<Menu x:Class="Silo.Ui.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="clr-namespace:Silo.Ui"
             xmlns:c="clr-namespace:Silo.Commanding"
             xmlns:l="clr-namespace:Silo"
             xmlns:design="clr-namespace:Silo.Design"
             mc:Ignorable="d"
             x:Name="MenuTop"
             DataContext="{Binding ., RelativeSource={RelativeSource AncestorType={x:Type l:MainWindow}, Mode=FindAncestor}}"
             d:DesignHeight="32" d:DesignWidth="800">
    <Menu.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!--
            BasedOn chains back to the app-wide flat MenuItem template in
            Theming/Theme.Styles.xaml (an implicit style declared here, with no BasedOn,
            would otherwise shadow it entirely within this menu's own scope - see that
            file's header comment).
        -->
        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Command.Header, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTip" Value="{Binding Command.ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Icon" Value="{Binding Command.Icon, RelativeSource={RelativeSource Self}, Converter={x:Static design:IconRefToVisualConverter.Instance}}" />
            <Setter Property="IsCheckable" Value="{Binding Command.IsCheckable, RelativeSource={RelativeSource Self}}" />
            <Setter Property="IsChecked" Value="{Binding Command.IsChecked, Mode=TwoWay, RelativeSource={RelativeSource Self}}" />
        </Style>
        <!--
            Used for each ITool's Tools-menu entry (via MenuGroup.ItemContainerStyle
            below). Binds straight off the ITool instance (each generated item's
            DataContext) rather than off Command.* like the style above, since an
            ITool's Header/Icon/IsEnabled/IsVisible live on the tool itself, not on a
            separate command object - and the tool doubles as its own Command, since
            ToolBase implements ICommand and Toggle() is what a click should invoke.
        -->
        <Style x:Key="ToolMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="Icon" Value="{Binding Icon, Converter={x:Static design:IconRefToVisualConverter.Instance}}" />
            <Setter Property="IsCheckable" Value="True" />
            <!--
                OneWay: IsChecked here mirrors ITool.IsChecked (whether the tool's
                window is open), it isn't a user-settable flag. Toggling happens only
                through Command/Toggle() below; a OneWay binding means a click-driven
                local flip of IsChecked can't fight with that or drift from the tool's
                actual window state.
            -->
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="Command" Value="{Binding}" />
        </Style>
    </Menu.Resources>

    <MenuItem x:Name="ViewMenu" Header="_View" SubmenuOpened="ViewMenu_SubmenuOpened">
        <MenuItem Header="_Theme" DataContext="{Binding App.Theme}">
            <MenuItem Header="_Light"
                           IsCheckable="True"
                           IsChecked="{Binding IsLight, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="Light" />
            <MenuItem Header="_Dark"
                           IsCheckable="True"
                           IsChecked="{Binding IsDark, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="Dark" />
            <MenuItem Header="_System"
                           IsCheckable="True"
                           IsChecked="{Binding IsSystem, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="System" />
        </MenuItem>
        <!--
            HyperCard-style User/Author/Developer/Debug mode (see Design/DesignLevel.cs).
            Author or above is required to reach the pink Ctrl+right-click design menus
            (see Design/DesignMenu.cs) - this is how you get there in the first place.
        -->
        <MenuItem Header="_User Level" DataContext="{Binding App.DesignLevel}">
            <MenuItem Header="_User"
                           IsCheckable="True"
                           IsChecked="{Binding IsUser, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="User" />
            <MenuItem Header="_Author"
                           IsCheckable="True"
                           IsChecked="{Binding IsAuthor, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="Author" />
            <MenuItem Header="_Developer"
                           IsCheckable="True"
                           IsChecked="{Binding IsDeveloper, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="Developer" />
            <MenuItem Header="De_bug"
                           IsCheckable="True"
                           IsChecked="{Binding IsDebug, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="Debug" />
        </MenuItem>
        <!--
            The dock panes can be closed with their own X; these bring them back (and hide them again). The check
            marks are refreshed each time the menu opens (ViewMenu_SubmenuOpened).
        -->
        <Separator />
        <MenuItem x:Name="ViewExplorer" Header="_Explorer" IsCheckable="True" Click="ViewPane_Click" />
        <MenuItem x:Name="ViewProperties" Header="_Properties" IsCheckable="True" Click="ViewPane_Click" />
        <MenuItem x:Name="ViewToolbox" Header="_Toolbox" IsCheckable="True" Click="ViewPane_Click" />
        <MenuItem x:Name="ViewProblems" Header="Pro_blems" IsCheckable="True" Click="ViewPane_Click"
                  ToolTip="What is wrong in the open text documents (JSON, XML and YAML that cannot be read, keys used twice...)" />
        <MenuItem x:Name="ViewSelectedItem" Header="Selected _Item" IsCheckable="True" Click="ViewPane_Click"
                  ToolTip="The view of the item selected in the Explorer (the italic preview tab; picking something in the navigation flyout replaces it)" />
        <Separator />
        <!-- The toolbar below the menu bar: shown or hidden here, customised, put back as it was. -->
        <MenuItem x:Name="ViewToolbar" Header="Tool_bar" IsCheckable="True" Click="ViewToolbar_Click"
                  ToolTip="Show or hide the toolbar below the menu bar" />
        <MenuItem Header="Customi_ze Toolbar..." Click="CustomizeToolbar_Click"
                  ToolTip="Add, remove, reorder, rename and re-icon the toolbar's buttons" />
        <MenuItem Header="Reset T_oolbar" Click="ResetToolbar_Click"
                  ToolTip="Put the toolbar's buttons back as a new installation has them, and show it" />
        <Separator />
        <MenuItem Header="Reset _Window Layout" Click="ResetLayout_Click"
                  ToolTip="Put the panes back where a new window has them and forget the remembered window sizes" />
        <Separator />
        <!-- the terminal in the status bar, as the Lab windows have it (Ui/Terminal/TerminalLine.cs, MainTerminal.cs) -->
        <MenuItem Header="_Terminal" InputGestureText="Ctrl+`" Click="Terminal_Click"
                  ToolTip="Put the cursor in the terminal in the status bar (help lists its commands)" />
        <MenuItem Header="Terminal _Log" Click="TerminalLog_Click"
                  ToolTip="What was typed in the terminal and what it answered" />
        <!-- Tables popped out into their own windows are listed here (filled in ViewMenu_SubmenuOpened). -->
        <Separator x:Name="ViewWindowsSeparator" Visibility="Collapsed" />
    </MenuItem>
    </Menu>

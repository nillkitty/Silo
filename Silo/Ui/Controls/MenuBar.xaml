<Menu x:Class="Silo.Ui.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="clr-namespace:Silo.Ui"
             xmlns:c="clr-namespace:Silo.Commanding"
             xmlns:l="clr-namespace:Silo"
             mc:Ignorable="d"
             x:Name="MenuTop"
             DataContext="{Binding ., RelativeSource={RelativeSource AncestorType={x:Type l:MainWindow}, Mode=FindAncestor}}"
             d:DesignHeight="32" d:DesignWidth="800">
    <Menu.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!--
            BasedOn chains back to the app-wide flat MenuItem template in
            Theming/Theme.Styles.xaml (an implicit style declared here, with no BasedOn,
            would otherwise shadow it entirely within this menu's own scope - see that
            file's header comment).
        -->
        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Command.Header, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTip" Value="{Binding Command.ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Icon" Value="{Binding Command.Icon, RelativeSource={RelativeSource Self}}" />
            <Setter Property="IsCheckable" Value="{Binding Command.IsCheckable, RelativeSource={RelativeSource Self}}" />
            <Setter Property="IsChecked" Value="{Binding Command.IsChecked, Mode=TwoWay, RelativeSource={RelativeSource Self}}" />
        </Style>
        <!--
            Used for each ITool's Tools-menu entry (via MenuGroup.ItemContainerStyle
            below). Binds straight off the ITool instance (each generated item's
            DataContext) rather than off Command.* like the style above, since an
            ITool's Header/Icon/IsEnabled/IsVisible live on the tool itself, not on a
            separate command object - and the tool doubles as its own Command, since
            ToolBase implements ICommand and Toggle() is what a click should invoke.
        -->
        <Style x:Key="ToolMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="Icon" Value="{Binding Icon}" />
            <Setter Property="IsCheckable" Value="True" />
            <!--
                OneWay: IsChecked here mirrors ITool.IsChecked (whether the tool's
                window is open), it isn't a user-settable flag. Toggling happens only
                through Command/Toggle() below; a OneWay binding means a click-driven
                local flip of IsChecked can't fight with that or drift from the tool's
                actual window state.
            -->
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="Command" Value="{Binding}" />
        </Style>
    </Menu.Resources>
    <MenuItem Header="_File" DataContext="{Binding App}">
        <MenuItem Header="_New Silo" InputGestureText="Ctrl+N" Command="{Binding NewSiloCommand}" />
        <MenuItem Header="_Open Silo" InputGestureText="Ctrl+O" Command="{Binding OpenSiloCommand}" />
        <MenuItem Header="Open from _URL..." InputGestureText="Ctrl+Shift+O" Command="{Binding OpenSiloFromUrlCommand}" />
        <Separator />
        <!-- These act on the active Silo: each item re-points its own DataContext from App (this menu's) to App.ActiveSilo. -->
        <MenuItem Header="_Save Silo" InputGestureText="Ctrl+S"
                  DataContext="{Binding ActiveSilo}"
                  CommandTarget="{Binding .}"
                  Command="{Binding Commands.SaveSilo}" />
        <MenuItem Header="Save Silo _As..." InputGestureText="Ctrl+Shift+S"
                  DataContext="{Binding ActiveSilo}"
                  CommandTarget="{Binding .}"
                  Command="{Binding Commands.SaveSiloAs}" />
        <MenuItem Header="_Close Silo"
                  DataContext="{Binding ActiveSilo}"
                  CommandTarget="{Binding .}"
                  Command="{Binding Commands.CloseSilo}" />
        <Separator />
        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{Binding ExitCommand}" />
    </MenuItem>
    <MenuItem Header="_Silo"
                   IsEnabled="{Binding ., Converter={StaticResource ObjectExistsToBool}}"
                   DataContext="{Binding App.ActiveSilo}">
        <MenuItem Header="_New Connection"
                       InputGestureText="Ctrl+Shift+N"
                       CommandTarget="{Binding .}"
                       Command="{Binding Commands.NewConnection}" />
        <MenuItem Header="_Credential" Command="{Binding Commands.NewCredential}" />
        <MenuItem Header="Convert to _Archive Format" CommandTarget="{Binding .}"  Command="{Binding Commands.ConvertToArchive}" />
        <Separator />
        <!--
            Add Data: things authored here rather than pulled from a source. Each item hands its kind to the same command
            as its CommandParameter (rich, plain or typed: see TableTemplate.FromKey).
        -->
        <MenuItem Header="Add _Data">
            <MenuItem Header="_Tabular">
                <MenuItem Header="_Rich Text" CommandTarget="{Binding .}" Command="{Binding Commands.NewTable}" CommandParameter="rich"
                          ToolTip="A table whose every column is rich text (bold, italic, code, links)" />
                <MenuItem Header="_Plain Text" CommandTarget="{Binding .}" Command="{Binding Commands.NewTable}" CommandParameter="plain"
                          ToolTip="A table whose every column is literal text" />
                <MenuItem Header="T_yped Columns" CommandTarget="{Binding .}" Command="{Binding Commands.NewTable}" CommandParameter="typed"
                          ToolTip="Starts with a text, a number and a date column; change each column's type as needed" />
                <Separator />
                <MenuItem Header="From _Clipboard..." CommandTarget="{Binding .}" Command="{Binding Commands.NewTable}" CommandParameter="clipboard"
                          ToolTip="A table made of the table or text on the clipboard (Excel, a web page, CSV...)" />
            </MenuItem>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Export/Backup" >
            <MenuItem Header="_Logs..." CommandTarget="{Binding .}"  Command="{Binding Commands.ExportLogs}" />
            <MenuItem Header="_State..." CommandTarget="{Binding .}"  Command="{Binding Commands.ExportState}" />
            <Separator />
            <MenuItem Header="_All..." CommandTarget="{Binding .}"  Command="{Binding Commands.ExportAll}" />

        </MenuItem>
        <MenuItem Header="_Import" >
            <MenuItem Header="_Data..." CommandTarget="{Binding .}"  Command="{Binding Commands.ImportData}" />
        </MenuItem>

    </MenuItem>
    <!--
        Standard editing acts on whichever control has the keyboard focus (a text box, the data grid...). Below the
        separator come the entries of the active document, added each time the menu opens (EditMenu_SubmenuOpened).
    -->
    <MenuItem x:Name="EditMenu" Header="_Edit" SubmenuOpened="EditMenu_SubmenuOpened">
        <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" />
        <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" />
        <Separator />
        <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" />
        <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" />
        <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" />
        <MenuItem Header="Paste as _New Table..." Click="PasteNewTable_Click"
                  ToolTip="Make a new table in the Silo from the table or text on the clipboard" />
        <MenuItem Header="_Delete" Command="ApplicationCommands.Delete" />
        <Separator />
        <MenuItem Header="Select _All" Command="ApplicationCommands.SelectAll" />
        <Separator x:Name="EditDynamicSeparator" Visibility="Collapsed" />
    </MenuItem>
    <MenuItem x:Name="ViewMenu" Header="_View" SubmenuOpened="ViewMenu_SubmenuOpened">
        <MenuItem Header="_Theme" DataContext="{Binding App.Theme}">
            <MenuItem Header="_Light"
                           IsCheckable="True"
                           IsChecked="{Binding IsLight, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="Light" />
            <MenuItem Header="_Dark"
                           IsCheckable="True"
                           IsChecked="{Binding IsDark, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="Dark" />
            <MenuItem Header="_System"
                           IsCheckable="True"
                           IsChecked="{Binding IsSystem, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="System" />
        </MenuItem>
        <!--
            HyperCard-style User/Author/Developer/Debug mode (see Design/DesignLevel.cs).
            Author or above is required to reach the pink Ctrl+right-click design menus
            (see Design/DesignMenu.cs) - this is how you get there in the first place.
        -->
        <MenuItem Header="_User Level" DataContext="{Binding App.DesignLevel}">
            <MenuItem Header="_User"
                           IsCheckable="True"
                           IsChecked="{Binding IsUser, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="User" />
            <MenuItem Header="_Author"
                           IsCheckable="True"
                           IsChecked="{Binding IsAuthor, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="Author" />
            <MenuItem Header="_Developer"
                           IsCheckable="True"
                           IsChecked="{Binding IsDeveloper, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="Developer" />
            <MenuItem Header="De_bug"
                           IsCheckable="True"
                           IsChecked="{Binding IsDebug, Mode=OneWay}"
                           Command="{Binding}"
                           CommandParameter="Debug" />
        </MenuItem>
        <!--
            The dock panes can be closed with their own X; these bring them back (and hide them again). The check
            marks are refreshed each time the menu opens (ViewMenu_SubmenuOpened).
        -->
        <Separator />
        <MenuItem x:Name="ViewExplorer" Header="_Explorer" IsCheckable="True" Click="ViewPane_Click" />
        <MenuItem x:Name="ViewProperties" Header="_Properties" IsCheckable="True" Click="ViewPane_Click" />
        <MenuItem x:Name="ViewToolbox" Header="_Toolbox" IsCheckable="True" Click="ViewPane_Click" />
        <Separator />
        <MenuItem Header="Reset _Window Layout" Click="ResetLayout_Click"
                  ToolTip="Put the panes back where a new window has them and forget the remembered window sizes" />
        <!-- Tables popped out into their own windows are listed here (filled in ViewMenu_SubmenuOpened). -->
        <Separator x:Name="ViewWindowsSeparator" Visibility="Collapsed" />
    </MenuItem>
    <MenuItem Header="_Run">

    </MenuItem>
    <MenuItem Header="_Tools"
                   DataContext="{Binding App.Tools}">
        <MenuItem Header="Manage Tools..."
                       Visibility="{Binding HasToolsAuthoring, Converter={StaticResource BoolToVisibility}}" />
        <Separator Visibility="{Binding HasToolsAuthoring, Converter={StaticResource BoolToVisibility}}" />
        <MenuItem Header="Break Debugger"
                       Command="{Binding Break}" />
        <!-- One MenuItem per ITool, appended here and kept in sync with Tools -->
        <l:MenuGroup ItemsSource="{Binding Tools}" ItemContainerStyle="{StaticResource ToolMenuItemStyle}" />
    </MenuItem>
    <MenuItem Header="_Help">
        <MenuItem Header="_About Silo..."
                       Command="{Binding App.About}"/>
    </MenuItem>
</Menu>

<t:RadMenu x:Class="Silo.Ui.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="clr-namespace:Silo.Ui"
             xmlns:c="clr-namespace:Silo.Commanding"
             xmlns:l="clr-namespace:Silo"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             x:Name="MenuTop"
             DataContext="{Binding ., RelativeSource={RelativeSource AncestorType={x:Type l:MainWindow}, Mode=FindAncestor}}"
             d:DesignHeight="32" d:DesignWidth="800">
    <t:RadMenu.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="{x:Type t:RadMenuItem}">
            <Setter Property="Header" Value="{Binding Command.Header, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTip" Value="{Binding Command.ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Icon" Value="{Binding Command.Icon, RelativeSource={RelativeSource Self}}" />
            <Setter Property="IsCheckable" Value="{Binding Command.IsCheckable, RelativeSource={RelativeSource Self}}" />
            <Setter Property="IsChecked" Value="{Binding Command.IsChecked, Mode=TwoWay, RelativeSource={RelativeSource Self}}" />
        </Style>
        <!--
            Used for each ITool's Tools-menu entry (via RadMenuGroup.ItemContainerStyle
            below). Binds straight off the ITool instance (each generated item's
            DataContext) rather than off Command.* like the style above, since an
            ITool's Header/Icon/IsEnabled/IsVisible live on the tool itself, not on a
            separate command object - and the tool doubles as its own Command, since
            ToolBase implements ICommand and Toggle() is what a click should invoke.
        -->
        <Style x:Key="ToolMenuItemStyle" TargetType="{x:Type t:RadMenuItem}">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="Icon" Value="{Binding Icon}" />
            <Setter Property="IsCheckable" Value="True" />
            <!--
                OneWay: IsChecked here mirrors ITool.IsChecked (whether the tool's
                window is open), it isn't a user-settable flag. Toggling happens only
                through Command/Toggle() below; a OneWay binding means Telerik's own
                click-driven local flip of IsChecked can't fight with that or drift
                from the tool's actual window state.
            -->
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="Command" Value="{Binding}" />
        </Style>
    </t:RadMenu.Resources>
    <t:RadMenuItem Header="_File" DataContext="{Binding App}">
        <t:RadMenuItem Header="_New Silo" Command="{Binding NewSiloCommand}"   />
        <t:RadMenuItem Header="_Open Silo" Command="{Binding OpenSiloCommand}" />
        <t:RadMenuSeparatorItem />
        <t:RadMenuItem Header="E_xit"  Command="{Binding ExitCommand}" />
    </t:RadMenuItem>
    <t:RadMenuItem Header="_Silo"
                   IsEnabled="{Binding ., Converter={StaticResource ObjectExistsToBool}}"
                   DataContext="{Binding App.ActiveSilo}">
        <t:RadMenuItem Header="C_onnection" 
                       CommandTarget="{Binding .}" 
                       Command="{Binding Commands.NewConnection}" />
        <t:RadMenuItem Header="_Credential" Command="{Binding Commands.NewCredential}" />
        <t:RadMenuItem Header="_Save Silo" CommandTarget="{Binding .}" Command="{Binding Commands.SaveSilo}" />
        <t:RadMenuItem Header="Save Silo _As..." CommandTarget="{Binding .}"  Command="{Binding Commands.SaveSiloAs}" />
        <t:RadMenuSeparatorItem />
        <t:RadMenuItem Header="_Export/Backup" >
            <t:RadMenuItem Header="_Logs..." CommandTarget="{Binding .}"  Command="{Binding Commands.ExportLogs}" />
            <t:RadMenuItem Header="_State..." CommandTarget="{Binding .}"  Command="{Binding Commands.ExportState}" />
            <t:RadMenuSeparatorItem />
            <t:RadMenuItem Header="_All..." CommandTarget="{Binding .}"  Command="{Binding Commands.ExportAll}" />

        </t:RadMenuItem>
        <t:RadMenuItem Header="_Import" >
            <t:RadMenuItem Header="_Data..." CommandTarget="{Binding .}"  Command="{Binding Commands.ImportData}" />
        </t:RadMenuItem>

    </t:RadMenuItem>
    <t:RadMenuItem Header="_Edit">

    </t:RadMenuItem>
    <t:RadMenuItem Header="_View">

    </t:RadMenuItem>
    <t:RadMenuItem Header="_Run">

    </t:RadMenuItem>
    <t:RadMenuItem Header="_Tools"
                   DataContext="{Binding App.Tools}">
        <t:RadMenuItem Header="Manage Tools..."
                       Visibility="{Binding HasToolsAuthoring, Converter={StaticResource BoolToVisibility}}" />
        <t:RadMenuSeparatorItem Visibility="{Binding HasToolsAuthoring, Converter={StaticResource BoolToVisibility}}" />
        <t:RadMenuItem Header="Break Debugger"
                       Command="{Binding Break}" />
        <!-- One RadMenuItem per ITool, appended here and kept in sync with Tools -->
        <l:RadMenuGroup ItemsSource="{Binding Tools}" ItemContainerStyle="{StaticResource ToolMenuItemStyle}" />
    </t:RadMenuItem>
    <t:RadMenuItem Header="_Help">
        <t:RadMenuItem Header="_About Silo..." 
                       Command="{Binding App.About}"/>
    </t:RadMenuItem>
</t:RadMenu>

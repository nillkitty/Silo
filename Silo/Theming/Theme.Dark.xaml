<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Silo's hand-rolled Dark palette (replaces the Telerik Windows11Theme dark preset).
        Same key set as Theme.Light.xaml - see the comment there and Theming/AppTheme.cs.
    -->

    <SolidColorBrush x:Key="Theme.Background" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="Theme.BackgroundAlt" Color="#FF252526" />
    <SolidColorBrush x:Key="Theme.Surface" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="Theme.SurfaceHover" Color="#FF37414D" />
    <SolidColorBrush x:Key="Theme.SurfacePressed" Color="#FF2A4A66" />
    <SolidColorBrush x:Key="Theme.Border" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="Theme.BorderStrong" Color="#FF6E6E6E" />
    <SolidColorBrush x:Key="Theme.Text" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="Theme.Accent" Color="#FF3D8BDB" />
    <SolidColorBrush x:Key="Theme.AccentHover" Color="#FF57A0EC" />
    <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.Selection" Color="#FF2C4A66" />
    <SolidColorBrush x:Key="Theme.Disabled" Color="#FF6A6A6A" />
    <SolidColorBrush x:Key="Theme.DisabledBackground" Color="#FF2A2A2A" />

</ResourceDictionary>

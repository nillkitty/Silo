<av:ResourceDictionary
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:p="clr-namespace:Silo.Parsing">

    <p:DataDefinition x:Key="IniValue">
        <p:Capture To="{p:InstanceNum}">
            <p:Split Delimiter="=" Qualifier='\"' Escape='\' MaxTokens="2">
               <p:Capture To="Key" Arity="One">
                    <p:Rest />
                </p:Capture>
                <p:Capture To="Value" Arity="Optional">
                    <p:Rest />
                </p:Capture>
            </p:Split>
        </p:Capture>
    </p:DataDefinition>

    <p:DataDefinition ContentType="text/ini"  x:Key="IniFile">
        <p:TextDefinition AnyEncoding="True">
            <p:Lines Newline="CrLf,Lax" Consolidate="True">
                <!-- ignore empty lines -->
                <p:Any>
                    <!-- Section header -->
                    <p:Capture To="{p:InstanceNum 'Section[{1}]'}">
                        <p:Span Start="[" End="]" />
                    </p:Capture>
                    <av:StaticResource ResourceKey="IniValue" />
                </p:Any>
            </p:Lines>
        </p:TextDefinition>
    </p:DataDefinition>

    <!-- matches single-line TSV data -->
    <p:TextDefinition x:Key="TsvData">
        <!-- Split by TAB, 
            permit elements surrounded by double quotes to contain TAB, 
            permit double quotes if escaped with a backslash
            escape a backaslash with two backslashes -->
        <p:Split Delimiter="&#x09;" Qualifier='\"' Escape='\\' Consolidate="False">
            <!-- For each element, capture the cell value as e.g. 'Col[0]', 'Col[1]', ...
               Placeholder {0} becomes the element number -->
            <p:Capture To="{p:InstanceNum 'Col[{0}]'}">
                <!-- Eat up the rest of the element -->
                <p:Rest />
            </p:Capture>
        </p:Split>
    </p:TextDefinition>



    <!-- matches single-line CSV data -->
    <p:TextDefinition x:Key="CsvData">
        <!-- Split by comma, 
            permit elements surrounded by double quotes to contain commas, 
            permit double quotes if escaped with a backslash
            escape a backaslash with two backslashes -->
        <p:Split Delimiter="," Qualifier='\"' Escape='\\'>
            <!-- For each element, capture the cell value as e.g. 'Col[0]', 'Col[1]', ...
               Placeholder {0} becomes the element number -->
            <p:Capture To="{p:InstanceNum 'Col[{0}]'}">
                <!-- Eat up the rest of the element -->
                <p:Rest />
            </p:Capture>
        </p:Split>
    </p:TextDefinition>


    <p:DataDefinition ContentType="text/csv"  x:Key="CsvFile">
        <p:TextDefinition AnyEncoding="True">
            <p:Lines Newline="CrLf,Lax">
                <p:DataDefinition x:Name="Header" Arity="One">
                    <!-- Header row: matches once -->
                    <p:Split Delimiter="," Qualifier='\"'>
                        <p:Capture To="{p:InstanceNum 'Header[{0}]'}" />

                    </p:Split>
                </p:DataDefinition>
                <p:DataDefinition x:Name="Row" Arity="Any">
                    <!-- Matches every other row -->

                    <av:StaticResource ResourceKey="CsvData" />

                </p:DataDefinition>            
            </p:Lines>
        </p:TextDefinition>
    </p:DataDefinition>

</av:ResourceDictionary>
<Application x:Class="Silo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Silo"
             xmlns:design="clr-namespace:Silo.Design"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="clr-namespace:Silo.Converters"
             StartupUri="/Ui/Windows/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Paths.xaml" />
                <!-- Hand-drawn nav icons; merged after Paths.xaml so its keys override the corrupted ones there. -->
                <ResourceDictionary Source="/Resources/NavIcons.xaml" />
                <ResourceDictionary Source="/Resources/DataDef/BasicFormats.xaml" />
                <!--
                    The app-wide control styles (Button, TextBox, MenuItem, TreeView, ToolBar, ...). Every brush in
                    it is a DynamicResource into the Theme.Light/Theme.Dark palette AppTheme swaps in, so without this
                    merge only elements that name a Theme.* brush themselves (the nav header) ever changed colour.
                -->
                <ResourceDictionary Source="/Theming/Theme.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <sys:String x:Key="AboutText">
                Silo version {0} by {1}
                {2}
                {3}
                Thanks to:
                {4}
    
                In Memory:
                {5}
            </sys:String>
            <sys:String x:Key="AboutAuthors">
                Nill (nill@nill.dev)
            </sys:String>
            <sys:String x:Key="AboutUrl">
                https://github.com/nillkitty/Silo
            </sys:String>
            <sys:String x:Key="AboutInfo">
                -
            </sys:String>
            <sys:String x:Key="AboutThanks">
                May, Liru, Epsilion, Lex, Aine, Mom, Brian
            </sys:String>
            <sys:String x:Key="AboutMemory">
                Ryley Raines, whom we lost way too soon
            </sys:String>
            <converters:ObjectExistsToBoolConverter x:Key="ObjectExistsToBool" />

            <!--
                Default template for AppIcon (see AppIcon.cs). Implicit (no x:Key -> applies
                to every AppIcon that doesn't set its own Style), so it's real XAML that XAML
                Hot Reload/Live Visual Tree can patch live while debugging - unlike the
                code-behind object graph the old AppIconExtension markup extension built.
                Fill/Stroke are TemplateBound to the control's own (ordinarily-inherited)
                Foreground, so an AppIcon placed anywhere automatically matches its container's
                text color, with no ancestor-type binding or hardcoded fallback color needed.
            -->
            <Style TargetType="{x:Type converters:AppIcon}">
                <!--
                    Live icon size: every AppIcon that doesn't set its own Size follows the Author-mode "Icon Size"
                    slider (Design/AppDesignSettings.cs). An explicit Size= on an instance still wins.
                -->
                <Setter Property="Size" Value="{Binding IconSize, Source={x:Static design:AppDesignSettings.Instance}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type converters:AppIcon}">
                            <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                                <Path Data="{TemplateBinding Icon}"
                                      Stretch="Uniform"
                                      Fill="{TemplateBinding Foreground}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="{TemplateBinding StrokeThickness}" />
                            </Viewbox>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

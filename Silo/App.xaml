<Application x:Class="Silo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Silo"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="/Ui/Windows/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Paths.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <sys:String x:Key="AboutText">
                Silo version {0} by {1}
                {2}
                {3}
                Thanks to:
                {4}
    
                In Memory:
                {5}
            </sys:String>
            <sys:String x:Key="AboutAuthors">
                Nill (nill@nill.dev)
            </sys:String>
            <sys:String x:Key="AboutUrl">
                https://github.com/nillkitty/Silo
            </sys:String>
            <sys:String x:Key="AboutInfo">
                -
            </sys:String>
            <sys:String x:Key="AboutThanks">
                May, Liru, Epsilion, Lex, Aine, Mom, Brian
            </sys:String>
            <sys:String x:Key="AboutMemory">
                Ryley Raines, whom we lost way too soon
            </sys:String>
            <local:ObjectExistsToBoolConverter x:Key="ObjectExistsToBool" />

            <!--
                Default template for AppIcon (see AppIcon.cs). Implicit (no x:Key -> applies
                to every AppIcon that doesn't set its own Style), so it's real XAML that XAML
                Hot Reload/Live Visual Tree can patch live while debugging - unlike the
                code-behind object graph the old AppIconExtension markup extension built.
                Fill/Stroke are TemplateBound to the control's own (ordinarily-inherited)
                Foreground, so an AppIcon placed anywhere automatically matches its container's
                text color, with no ancestor-type binding or hardcoded fallback color needed.
            -->
            <Style TargetType="{x:Type local:AppIcon}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:AppIcon}">
                            <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                                <Path Data="{TemplateBinding Icon}"
                                      Stretch="Uniform"
                                      Fill="{TemplateBinding Foreground}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="{TemplateBinding StrokeThickness}" />
                            </Viewbox>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Trace" Version="4.0.0" />
    <PackageReference Include="Telefrag.Common" Version="2026.9.11.372" />
    <!--
        Replaces the whole Telerik.UI.for.Wpf.AllControls.Xaml / Diagrams.Extensions /
        Documents.* / Pivot.Core stack. The Documents/Pivot packages were never actually
        used by any code in this project (dead references); everything else (menus,
        docking, dialogs, theming, the property-grid/grid-view auto UI, the nav tree, and
        the connection diagram) has been rewritten onto plain WPF plus AvalonDock, the one
        remaining third-party dependency - a free, MIT-licensed, community-maintained
        docking manager (the actively-developed continuation of the original AvalonDock,
        published by its longtime maintainer since Xceed's fork went partly commercial).
    -->
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Providers\Uri\" />
    <Folder Include="Subconnectors\" />
    <Folder Include="ViewModel\Features\" />
  </ItemGroup>



</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
      
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Program.Main (not the XAML-generated one) is the entry point: it picks GUI or command mode. -->
    <StartupObject>Silo.Program</StartupObject>
  </PropertyGroup>
	<PropertyGroup>
		<WarningsAsErrors>$(WarningsAsErrors);SILO001</WarningsAsErrors>
	</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="easywindowsterminalcontrol" Version="1.0.38" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.23.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Trace" Version="4.0.0" />
    <PackageReference Include="Telefrag.Common" Version="2026.9.11.372" />
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.1" />
    <!-- AvalonDock 5 moved XmlLayoutSerializer out of the main package (namespace AvalonDock.Serializer.Xml); MainWindow saves/restores the dock layout with it. -->
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" Version="5.0.1" />
    <!-- Dark/Light chrome for the docking area (swapped by MainWindow when AppTheme changes). -->
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.1" />
    <!-- SQLite persistence layer (DbModel/Sqlite/*.cs) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- SQL Server connector (Connectors/Sql/*.cs) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Credentials: Windows data protection (DPAPI) is the default secret protector (Crypto/DpapiSecretProtector.cs) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <!-- JsonFormat (Providers/Format/JsonFormat.cs) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- YamlFormat (Providers/Format/YamlFormat.cs) -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- MarkdownFormat / MarkdownDataProvider (Providers/Format/MarkdownFormat.cs, MarkdownDataProvider.cs) -->
    <PackageReference Include="Markdig" Version="1.4.1" />
    <!-- LDAP / Active Directory connector (Connectors/Ldap/*.cs) -->
    <PackageReference Include="System.DirectoryServices" Version="10.0.9" />
    <!-- Embedded draw.io (Drawio/*.cs): hosts the draw.io editor in a WebView2 pane -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!--
      Costura folds the managed references into Silo.dll (see FodyWeavers.xml); Silo.exe and Silo.com are small
      stubs that start it. Fody is build-time only.
    -->
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Costura.Fody" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The Silo plugin injected into the draw.io editor (see Drawio/PLUGIN-ARCHITECTURE.md). -->
    <EmbeddedResource Include="Drawio\Plugin\silo-plugin.js" LogicalName="silo-plugin.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- SILO001: warns when an implementation of an interface marked [RequireRegistration] declares no registration attribute -->
    <ProjectReference Include="..\Silo.Analyzers\Silo.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Connectors\System\SysObj\" />
    <Folder Include="Authoring\" />
    <Folder Include="Providers\Uri\" />
    <Folder Include="Subconnectors\" />
    <Folder Include="ViewModel\Features\" />
  </ItemGroup>

  <!--
    After each build: make Silo.com (the console copy of the Silo.exe stub) and drop the now-embedded managed
    assemblies from Silo.deps.json. See tools/PostBuild.ps1.
  -->
  <Target Name="SiloStubs" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\PostBuild.ps1&quot; -OutDir &quot;$(OutDir.TrimEnd('\'))&quot; -Name &quot;$(AssemblyName)&quot;" ContinueOnError="true" />
  </Target>

</Project>
